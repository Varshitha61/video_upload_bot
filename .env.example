# ─────────────────────────────────────────────────────────────────────────────
# ASMR Video Automation Pipeline — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the .env file to git. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ──────────────────────────────────────────
# Generation Mode
# ──────────────────────────────────────────

# Options: pexels | huggingface | auto
# pexels      → free stock footage (recommended, no GPU needed)
# huggingface → AI generation locally (requires NVIDIA GPU + ~8GB VRAM)
# auto        → HF if GPU found, else Pexels
GENERATION_MODE=pexels


# ──────────────────────────────────────────
# Pexels (free stock video — PRIMARY source)
# ──────────────────────────────────────────

# Free API key from https://www.pexels.com/api/
# Rate limit: 200 req/hr, 20,000 req/month (more than enough)
PEXELS_API_KEY=your_pexels_api_key_here


# ──────────────────────────────────────────
# HuggingFace (optional — local GPU text-to-video)
# ──────────────────────────────────────────

# Free token from https://huggingface.co/settings/tokens
# Only needed if GENERATION_MODE=huggingface
HF_TOKEN=your_huggingface_token_here

# HF model to use for local generation (requires GPU)
# Lighter: cerspense/zeroscope_v2_576w  (~4GB VRAM)
# Better:  ali-vilab/text-to-video-ms-1.7b  (~8GB VRAM)
HF_MODEL=cerspense/zeroscope_v2_576w


# ──────────────────────────────────────────
# YouTube Data API v3
# ──────────────────────────────────────────

# Path to the OAuth2 client_secret JSON downloaded from Google Cloud Console.
# Download from: https://console.cloud.google.com/apis/credentials
# (Create → OAuth client ID → Desktop app → Download JSON)
YOUTUBE_CLIENT_SECRET_PATH=client_secret.json

# Where the OAuth2 token will be saved after first-time browser auth.
# This file is auto-created on first run. DO NOT commit to git.
YOUTUBE_TOKEN_PATH=youtube_token.json

# YouTube video category ID (default 22 = People & Blogs).
# Full list: https://developers.google.com/youtube/v3/docs/videoCategories/list
YOUTUBE_CATEGORY_ID=22

# Default privacy for uploaded videos. Options: private | unlisted | public
# Start with "private" and manually publish once you've reviewed the upload.
YOUTUBE_PRIVACY_STATUS=private


# ──────────────────────────────────────────
# Telegram Bot API
# ──────────────────────────────────────────

# Your Telegram Bot Token obtained from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Chat ID of the user, group, or channel where the video should be sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ──────────────────────────────────────────
# Pinterest API v5
# ──────────────────────────────────────────

# Your Pinterest Developer App Access Token (needs pins:write and boards:read scopes)
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here

# The ID of the board you want to pin the video to
PINTEREST_BOARD_ID=your_pinterest_board_id_here


# ──────────────────────────────────────────
# AI Content Disclosure
# ──────────────────────────────────────────

# Set to "true" to enable AI-generated content disclosure labels on uploads.
# NOTE: Exact API field names change over time; see TODO comments in
# upload_youtube.py and upload_instagram.py for current status.
AI_CONTENT_DISCLOSURE=true


# ──────────────────────────────────────────
# Output Paths
# ──────────────────────────────────────────

# Directory for all generated output files (created automatically)
OUTPUT_DIR=output

# Subdirectory for raw Veo clips (created automatically)
CLIPS_DIR=output/clips
